[Unit]
Description=UAV navigation GPS_INPUT integration bridge
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=uav
Group=uav
SupplementaryGroups=dialout
WorkingDirectory=/opt/uav-navigation2
EnvironmentFile=/etc/uav-navigation/bridge.env
ExecStart=/usr/bin/python3 -m integration.mavlink_bridge --listen ${NAV_LISTEN} --output-udp ${MAVLINK_TARGET} --timeout 0.5 --max-horizontal-sigma ${MAX_HORIZONTAL_SIGMA} --reject-health-mask ${REJECT_HEALTH_MASK}
Restart=on-failure
RestartSec=1
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
